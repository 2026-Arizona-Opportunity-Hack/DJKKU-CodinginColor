# Copy to .env and fill in real values. .env is gitignored; this file is the
# documentation of what the app needs. Never put real keys in here.
#
# VITE_* values are bundled into the browser, so only put values here that are
# safe to be public. Everything else is a server secret: set it in the host's
# environment (Cloudflare Pages > Settings > Variables), never in the browser.

# --- Browser-safe (Supabase project > Settings > API) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only secrets (Pages Functions: read API, AI hints) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Bypasses RLS. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Free-tier Gemini key from Google AI Studio (no billing account attached).
GEMINI_API_KEY=your-gemini-key
