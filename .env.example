# Copy to .env and fill in real values. .env is gitignored; this file is the
# documentation of what the app needs. Never put real keys in here.
#
# VITE_* values are bundled into the browser, so only put values here that are
# safe to be public. Everything else is a server secret: set it in the host's
# environment (Cloudflare Pages > Settings > Variables), never in the browser.

# --- Browser-safe (Supabase project > Settings > API) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only secrets (Pages Functions: read API, AI hints) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The same public anon key as above; the hint function uses it to check a student's token.
SUPABASE_ANON_KEY=your-anon-public-key
# Bypasses RLS. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Free-tier Gemini key from Google AI Studio (no billing account attached).
GEMINI_API_KEY=your-gemini-key
# "Find material" for authors. YouTube Data API v3 key (Google Cloud > APIs > YouTube Data API v3 >
# Credentials > API key, restricted to that API). Without it, only GitHub is searched.
YOUTUBE_API_KEY=your-youtube-data-api-key
# Optional GitHub token with NO scopes (fine-grained, public repositories read-only): 30 searches a
# minute instead of 10.
GITHUB_TOKEN=

# --- Student player (lane B), browser-safe ---
# mock = in-memory demo data (no backend); supabase = real data. If unset, the
# player uses supabase when VITE_SUPABASE_URL is set, otherwise mock.
VITE_DATA_SOURCE=mock
# Show "Get a hint" after a wrong answer (calls POST /api/hint).
VITE_FEATURE_HINTS=false
# Base URL for Pages Functions (/api/...). Empty = same origin.
VITE_API_BASE=
